#!/usr/bin/env bash
# Sync Homebrew packages with ~/.Brewfile.
# Re-runs whenever the rendered Brewfile content changes (run_onchange_).
#
# Brewfile content hash: {{ include "dot_Brewfile.tmpl" | sha256sum }}

set -euo pipefail

if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

echo "Running brew bundle (~/.Brewfile)..."
brew bundle --global
