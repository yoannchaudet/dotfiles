# Orbstack (if this file does not exist SSH should be ok with it)
Include ~/.orbstack/ssh/config

# Use Bitwarden Desktop as the SSH agent (https://bitwarden.com/help/ssh-agent/).
# Bitwarden must be running and unlocked for SSH auth/signing to work.
IdentityAgent ~/.bitwarden-ssh-agent.sock

#
# GitHub
#
Host bastion*.githubapp.com vault-bastion*.githubapp.com
  ForwardAgent yes
  User yoannchaudet
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%C
  ControlPersist 600
Host github.com *.github.net *.githubapp.com
  ForwardAgent no
  User yoannchaudet
Host shell
  Hostname ce-shell-e932d29.ac4-iad.github.net
  ForwardAgent yes
  ProxyJump bastion.githubapp.com
  User yoannchaudet
Host shell2
  Hostname ce-shell-1aab30f.va3-iad.github.net
  ForwardAgent yes
  ProxyJump bastion.githubapp.com
  User yoannchaudet
Host shell3
  Hostname ce-shell-ea5409b.ash1-iad.github.net
  ForwardAgent yes
  ProxyJump bastion.githubapp.com
  User yoannchaudet
Host old-shell
  Hostname shell.service.ac4-iad.github.net
  ForwardAgent yes
  ProxyJump bastion.githubapp.com
  User yoannchaudet

#
# Binggan (home server)
