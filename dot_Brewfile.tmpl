# Brewfile (managed by chezmoi)
# Edit dot_Brewfile.tmpl in the dotfiles repo, then run `chezmoi apply`.
# `brew bundle --global` is re-run automatically by run_onchange_after_20-brew-bundle.sh.tmpl.

#
# Shared (installed on every machine)
#

# Meta
brew "chezmoi"

# Shell & terminal
brew "fish"
cask "ghostty"

# Git / GitHub
brew "git"
brew "git-lfs"
brew "git-crypt"
brew "gnupg"
brew "gh"

# Languages & runtimes
brew "go"
brew "python"
brew "rbenv"

# Containers & VMs
cask "orbstack"

# Infrastructure / cloud
brew "tfenv"
brew "tflint"
brew "azure-cli"
cask "microsoft-azure-storage-explorer"

# .NET / PowerShell
cask "powershell"
cask "dotnet-sdk"

# Static site / web
brew "hugo"
brew "sass/sass/sass"

# Core CLI utilities
brew "wget"
brew "tree"
brew "bat"
brew "fd"
brew "ripgrep"
brew "difftastic"

# Data / file inspection
brew "yq"
brew "hexyl"
brew "homeport/tap/dyff"
brew "imagemagick"
brew "exiftool"

# AI tooling
brew "anomalyco/tap/opencode"
cask "copilot-cli"

# Editors
cask "visual-studio-code"
cask "obsidian"

# Browsers
cask "microsoft-edge"

# Productivity / window management
cask "rectangle"
cask "itsycal"
cask "clipy"
cask "shottr"

# Security & storage
cask "bitwarden"
cask "google-drive"

{{ if eq .profile "work" -}}
#
# Work only
#

# Architecture / process
brew "adr-tools"
{{- end }}

{{ if eq .profile "personal" -}}
