brew "vegeta"

# Diagramming
brew "d2"

# Embedded / home automation
brew "esphome"
brew "platformio"

# Media & document tooling (CLI)
brew "ghostscript"
brew "icloudpd"
brew "czkawka"

# Creative / 3D
cask "blender"
# cask "autodesk-fusion"
cask "adobe-creative-cloud"

